{"is_source_file": true, "format": "JavaScript", "description": "This file initializes an Express.js web server for the EKYCBackendService. It sets up middleware for CORS, JSON parsing, and error handling. The server provides endpoints for health checks, serving the OpenAPI specification, and mounts additional routes for authentication and bank details. It dynamically loads and injects server URL information into the OpenAPI spec.", "external_files": ["./middleware/errorHandler", "./routes/health", "./routes/auth", "./routes/bank"], "external_methods": ["require('cors')", "require('express')", "require('fs')", "require('path')", "require('swagger-ui-express')", "require('js-yaml')", "errorHandler (from ./middleware/errorHandler)"], "published": ["app"], "classes": [], "methods": [{"name": "app.get('/')", "description": "Health and root info endpoint providing basic service status and links."}, {"name": "app.get('/openapi.json')", "description": "Serves the OpenAPI specification in JSON format, loaded from a YAML file and dynamically injects server URL."}, {"name": "app.get('/interfaces/openapi.yaml')", "description": "Serves the raw OpenAPI YAML file from disk."}, {"name": "app.use('/api/auth')", "description": "Mounts authentication routes."}, {"name": "app.use('/api')", "description": "Mounts bank-related routes."}, {"name": "app.use(errorHandler)", "description": "Adds centralized error handling middleware."}], "calls": ["require('cors')", "require('express')", "require('fs')", "require('path')", "require('swagger-ui-express')", "require('js-yaml')", "errorHandler (from ./middleware/errorHandler)"], "search-terms": ["express app initialization", "openapi json load", "swagger UI setup", "health endpoint", "routes mounting", "yaml parsing"], "state": 2, "file_id": 7, "knowledge_revision": 156, "git_revision": "b04aa8e2aa7b323721fbb61b33f5550b0d1ec955", "revision_history": [{"23": "e84b864961e2f7dd3769ca2015764f34400d1881"}, {"52": "e84b864961e2f7dd3769ca2015764f344